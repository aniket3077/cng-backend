# ⚠️ SECURITY WARNING: This is an example file. Copy to .env and fill with actual values
# NEVER commit .env with real secrets to git

# Database Configuration
# Generate strong credentials and use AWS Secrets Manager in production
DATABASE_URL="postgresql://username:password@host:5432/database?sslmode=require"
DIRECT_URL="postgresql://username:password@host:5432/database?sslmode=require"

# JWT Secrets (Generate with: openssl rand -base64 48)
JWT_SECRET="your-super-secret-jwt-key-minimum-48-characters-long"
JWT_REFRESH_SECRET="your-different-super-secret-refresh-key-minimum-48-characters"

# Admin bootstrap (used by scripts/create-admin.ts)
ADMIN_EMAIL="admin@cngbharat.com"
ADMIN_PASSWORD="your-strong-admin-password-min-12-chars"

# Application Configuration
NODE_ENV="development"
NEXT_PUBLIC_API_URL="http://localhost:5000"
PORT=5000
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# Google Maps API Key (Create restricted key in Google Cloud Console)
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Razorpay (Payment Gateway)
RAZORPAY_KEY_ID="your-razorpay-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# Resend (Email Service)
RESEND_API_KEY="your-resend-api-key"
FROM_EMAIL="noreply@yourdomain.com"

# Redis (Required for security features)
# Get free Redis from: https://upstash.com/ or https://redis.com/
REDIS_URL="redis://default:password@host:6379"
